---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	/** Intended CSS display width in px; a 2x variant is generated for high-DPI screens. */
	width: number;
	quality?: number;
	class?: string;
	imgClass?: string;
}

const {
	src,
	alt,
	width,
	quality = 85,
	class: className = '',
	imgClass = '',
} = Astro.props;
---

<Image
	src={src}
	alt=""
	width={Math.min(src.width, 24)}
	quality={20}
	aria-hidden="true"
	style="opacity:0"
	onload="this.style.opacity=1"
	class:list={[
		'absolute inset-0 scale-105 blur-md transition-opacity duration-300',
		className,
	]}
/>
<Image
	src={src}
	alt={alt}
	width={Math.min(src.width, width)}
	widths={[width, width * 2]}
	sizes={`${width}px`}
	quality={quality}
	loading="lazy"
	style="opacity:0"
	onload="this.style.opacity=1"
	class:list={[
		'absolute inset-0 transition-opacity duration-300 ease-out',
		className,
		imgClass,
	]}
/>
