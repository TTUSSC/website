---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import DifficultyStars from './DifficultyStars.astro';
import LectureTimeline from './LectureTimeline.astro';
import { getLang } from '../../i18n/ui';
import { semesterLabel } from '../../lib/lectures';

interface Props {
	semester: string;
	entries: CollectionEntry<'lectures'>[];
	allSemesters: string[];
	openSlug?: string;
}

const { semester, entries, allSemesters, openSlug } = Astro.props;
const lang = getLang(Astro.currentLocale);

const content = {
	'zh-tw': {
		eyebrow: 'Lectures',
		heading: '社課',
		intro:
			'學長姐手把手教學，搭配業界前輩實戰分享。在這裡，你可以學程式、做專案，也能輕鬆交友。無論你的目標是什麼，這裡都有適合你的位置，帶你踏入開源世界的無限可能！',
		difficultyLabel: '了解課程難度分級',
		difficultyIntro:
			'為了方便大家選擇感興趣的活動，我們的課程難度一共分為六個等級：',
		difficultyLevels: [
			{ d: 0, label: '一般性質活動，任何人都可以一同參與。' },
			{ d: 1, label: '非常簡單，適合完全新手，無需任何背景知識。' },
			{ d: 2, label: '簡單，需具備基本概念或基礎能力。' },
			{ d: 3, label: '中等，內容稍具挑戰性，適合已有相關經驗的人。' },
			{ d: 4, label: '困難，需要較多背景知識或具備一定專業技能。' },
			{ d: 5, label: '非常困難，適合高水準的學習者或專業人士。' },
		],
		filters: { all: '全部', main: '主線', side: '支線' },
		empty: '這學期目前還沒有社課資料。',
		close: '關閉',
		slide: '簡報',
		cowrite: '共筆',
		slido: 'Slido',
		kktix: 'KKTIX',
	},
} as const;
const t = content[lang as keyof typeof content] ?? content['zh-tw'];

const semesterBaseUrl = getRelativeLocaleUrl(lang, `lecture/${semester}`);

const entriesWithContent = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		Content: (await render(entry)).Content,
	})),
);
---

<div
	class="max-w-5xl mx-auto px-6 py-20 md:py-24"
	data-semester-base-url={semesterBaseUrl}
	data-open-slug={openSlug}
>
	<span
		class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-moss"
		>{t.eyebrow}</span
	>
	<h1 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2 mb-3">
		{t.heading}
	</h1>
	<p class="text-base md:text-lg text-clay leading-relaxed max-w-3xl mb-4">
		{t.intro}
	</p>

	<div class="relative group inline-block z-20 mb-6">
		<div
			tabindex="0"
			class="flex items-center gap-1.5 text-clay cursor-help hover:text-ink transition-colors"
		>
			<svg
				class="w-4 h-4 text-moss"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"
				></path>
			</svg>
			<span class="text-sm border-b border-dashed border-clay/50"
				>{t.difficultyLabel}</span
			>
		</div>
		<div
			class="absolute left-0 top-full mt-2 w-[320px] sm:w-[500px] p-5 bg-paper backdrop-blur-xl border border-chalk/80 shadow-xl rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0 group-focus-within:translate-y-0 origin-top-left pointer-events-none group-hover:pointer-events-auto"
		>
			<p class="text-[13px] text-ink/90 leading-relaxed mb-4">
				{t.difficultyIntro}
			</p>
			<ul class="space-y-2.5 text-[13px] text-ink/80 font-medium">
				{
					t.difficultyLevels.map((level) => (
						<li class="flex items-center gap-3">
							<DifficultyStars
								difficulty={level.d}
								idPrefix={`legend-${level.d}`}
							/>
							<span>：{level.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="flex flex-wrap gap-2 mb-6">
		{
			allSemesters.map((s) => (
				<a
					href={getRelativeLocaleUrl(lang, `lecture/${s}`)}
					class:list={[
						'px-3 py-1.5 text-xs font-display font-medium rounded-md transition-all duration-200',
						s === semester
							? 'bg-ink text-paper'
							: 'text-clay border border-chalk hover:border-ink hover:text-ink',
					]}
				>
					{semesterLabel(s)}
				</a>
			))
		}
	</div>

	<div class="flex gap-2 mb-8">
		<button
			type="button"
			data-filter="全部"
			class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-rust text-paper"
		>
			{t.filters.all}
		</button>
		<button
			type="button"
			data-filter="主線"
			class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-fog text-clay hover:text-ink"
		>
			{t.filters.main}
		</button>
		<button
			type="button"
			data-filter="支線"
			class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-fog text-clay hover:text-ink"
		>
			{t.filters.side}
		</button>
	</div>

	<div class="space-y-2">
		{
			entriesWithContent.map(({ entry, Content }) => {
				const { data } = entry;
				const links = (
					[
						{ label: t.slide, href: data.slide },
						{ label: t.cowrite, href: data.cowrite },
						{ label: t.slido, href: data.slido },
						{ label: t.kktix, href: data.kktix },
					] as { label: string; href: string | undefined }[]
				).filter((link): link is { label: string; href: string } =>
					Boolean(link.href),
				);

				return (
					<>
						<a
							href={`${semesterBaseUrl}${semesterBaseUrl.endsWith('/') ? '' : '/'}${data.slug}/`}
							data-open-modal={`modal-${data.slug}`}
							class="lecture-card w-full text-left flex items-center gap-4 bg-paper-warm rounded-2xl border border-chalk/60 px-6 py-5 transition-all duration-300 hover:border-rust/30 hover:shadow-md"
							data-type={data.type}
						>
							<div class="shrink-0 w-14 text-center">
								<span class="text-xs font-mono text-sand">
									{data.date.toLocaleDateString('zh-TW', {
										month: 'numeric',
										day: 'numeric',
										timeZone: 'UTC',
									})}
								</span>
							</div>
							<div class="flex-1 min-w-0">
								<h3 class="font-display font-semibold text-ink text-base leading-snug">
									{data.name}
								</h3>
								<div class="flex items-center gap-2 mt-1 flex-wrap">
									<DifficultyStars
										difficulty={data.difficulty}
										idPrefix={`card-${data.slug}`}
									/>
									<span class="text-xs text-sand">{data.lecturer}</span>
									<span
										class:list={[
											'px-2 py-0.5 text-xs rounded-sm',
											data.type === '主線'
												? 'bg-moss/10 text-moss'
												: 'bg-rust/10 text-rust',
										]}
									>
										{data.type}
									</span>
								</div>
							</div>
						</a>

						<dialog
							id={`modal-${data.slug}`}
							class="lecture-modal"
							data-slug={data.slug}
							aria-labelledby={`modal-title-${data.slug}`}
						>
							<div class="lecture-modal-content">
								<button type="button" class="modal-close" aria-label={t.close}>
									✕
								</button>

								<span class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-moss">
									{data.date.toLocaleDateString('zh-TW', {
										month: 'long',
										day: 'numeric',
										timeZone: 'UTC',
									})}
								</span>
								<h2
									id={`modal-title-${data.slug}`}
									class="font-display text-2xl md:text-3xl font-bold text-ink mt-2 mb-4"
								>
									{data.name}
								</h2>

								<div class="flex items-center gap-3 flex-wrap mb-6">
									<DifficultyStars
										difficulty={data.difficulty}
										idPrefix={`modal-${data.slug}`}
										size="md"
									/>
									<span class="text-sm text-sand">{data.lecturer}</span>
									<span
										class:list={[
											'px-2 py-0.5 text-xs rounded-sm',
											data.type === '主線'
												? 'bg-moss/10 text-moss'
												: 'bg-rust/10 text-rust',
										]}
									>
										{data.type}
									</span>
								</div>

								{data.location && (
									<div class="flex items-center gap-2 text-[14px] text-clay mb-4">
										<svg
											class="w-4 h-4"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											viewBox="0 0 24 24"
										>
											<path
												stroke-linecap="round"
												d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
											/>
											<path
												stroke-linecap="round"
												d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
											/>
										</svg>
										{data.location}
									</div>
								)}

								<div class="prose prose-sm md:prose-base max-w-none text-ink/90 mb-6">
									<Content />
								</div>

								{data.tags.length > 0 && (
									<div class="flex flex-wrap gap-1.5 mb-8">
										{data.tags.map((tag) => (
											<span class="px-2.5 py-0.5 text-xs md:text-sm bg-fog text-clay rounded-sm">
												#{tag}
											</span>
										))}
									</div>
								)}

								{data.timeline && <LectureTimeline items={data.timeline} />}

								{links.length > 0 && (
									<div class="flex flex-wrap gap-2 pt-6">
										{links.map((link) => (
											<a
												href={link.href}
												target="_blank"
												rel="noopener noreferrer"
												class="text-sm px-3.5 py-2 border border-chalk rounded-md text-rust hover:bg-rust/5 transition-colors"
											>
												{link.label} →
											</a>
										))}
									</div>
								)}
							</div>
						</dialog>
					</>
				);
			})
		}
	</div>

	<p class="text-center text-clay py-12 text-sm hidden" id="lecture-empty">
		{t.empty}
	</p>
</div>

<style>
	.lecture-card:active {
		transform: none;
	}

	dialog.lecture-modal {
		margin: auto;
		padding: 0;
		border: none;
		background: transparent;
		width: min(48rem, 90vw);
		max-height: 90vh;
	}

	dialog.lecture-modal::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}

	.lecture-modal-content {
		position: relative;
		max-height: 90vh;
		overflow-y: auto;
		padding: 2rem;
		background: var(--color-paper);
		border-radius: 1rem;
		scrollbar-width: thin;
		scrollbar-color: var(--color-chalk) transparent;
	}

	.modal-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
	}
</style>

<script>
	const filterButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.lecture-filter-btn'),
	);
	const cards = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.lecture-card'),
	);
	const emptyMessage = document.getElementById('lecture-empty')!;

	const applyFilter = (filter: string) => {
		let visibleCount = 0;
		cards.forEach((card) => {
			const matches = filter === '全部' || card.dataset.type === filter;
			card.classList.toggle('hidden', !matches);
			if (matches) visibleCount++;
		});
		emptyMessage.classList.toggle('hidden', visibleCount > 0);
	};

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			filterButtons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('bg-rust', active);
				b.classList.toggle('text-paper', active);
				b.classList.toggle('bg-fog', !active);
				b.classList.toggle('text-clay', !active);
			});
			applyFilter(button.dataset.filter!);
		});
	});
</script>

<script>
	const root = document.querySelector(
		'[data-semester-base-url]',
	) as HTMLElement;
	const semesterBaseUrl = root.dataset.semesterBaseUrl!;
	const openSlug = root.dataset.openSlug;

	// semesterBaseUrl (from getRelativeLocaleUrl) already ends in "/".
	const lectureUrl = (slug: string) => `${semesterBaseUrl}${slug}/`;

	const openLinks = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('[data-open-modal]'),
	);
	const modals = Array.from(
		document.querySelectorAll<HTMLDialogElement>('.lecture-modal'),
	);

	openLinks.forEach((link) => {
		link.addEventListener('click', (event) => {
			// Let middle-click / cmd-click / ctrl-click / shift-click fall
			// through to a real navigation (new tab, new window, etc.).
			if (
				event.button !== 0 ||
				event.metaKey ||
				event.ctrlKey ||
				event.shiftKey ||
				event.altKey
			) {
				return;
			}
			const targetId = link.dataset.openModal;
			if (!targetId) return;
			const dialog = document.getElementById(
				targetId,
			) as HTMLDialogElement | null;
			if (!dialog) return;
			event.preventDefault();
			dialog.showModal();
			const slug = dialog.dataset.slug;
			if (slug) history.pushState(null, '', lectureUrl(slug));
		});
	});

	modals.forEach((dialog) => {
		const closeButton = dialog.querySelector<HTMLButtonElement>('.modal-close');
		closeButton?.addEventListener('click', () => dialog.close());

		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.addEventListener('close', () => {
			const slug = dialog.dataset.slug;
			if (slug && location.pathname === lectureUrl(slug)) {
				history.pushState(null, '', semesterBaseUrl);
			}
		});
	});

	if (openSlug) {
		const target = document.querySelector<HTMLDialogElement>(
			`.lecture-modal[data-slug="${CSS.escape(openSlug)}"]`,
		);
		if (target && !target.open) target.showModal();
	}

	window.addEventListener('popstate', () => {
		const currentlyOpen =
			document.querySelector<HTMLDialogElement>('dialog[open]');
		const shouldBeOpen = modals.find(
			(dialog) =>
				dialog.dataset.slug &&
				location.pathname === lectureUrl(dialog.dataset.slug),
		);

		if (shouldBeOpen === currentlyOpen) return;

		if (currentlyOpen) currentlyOpen.close();
		if (shouldBeOpen) shouldBeOpen.showModal();
	});
</script>
