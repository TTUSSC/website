---
interface Props {
	difficulty: number;
	idPrefix: string;
	size?: 'sm' | 'md';
}

const { difficulty, idPrefix, size = 'sm' } = Astro.props;
const sizeClass = size === 'sm' ? 'w-3.5 h-3.5' : 'w-4 h-4';

function getStarFills(d: number): number[] {
	return Array.from({ length: 5 }, (_, i) => {
		const raw = Math.min(Math.max(d - i, 0), 1);
		return Math.round(raw * 4) / 4;
	});
}

const fills = getStarFills(difficulty);
---

<span class="inline-flex items-center gap-0.5">
	{
		fills.map((fill, i) => (
			<svg
				viewBox="0 0 24 24"
				class={sizeClass}
				xmlns="http://www.w3.org/2000/svg"
			>
				<defs>
					<clipPath id={`${idPrefix}-${i}`}>
						<rect x="0" y="0" width={fill * 24} height="24" />
					</clipPath>
				</defs>
				<path
					d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
					fill="#e8e3d8"
					stroke={fill > 0 ? '#f59e0b' : '#d4cbbf'}
					stroke-width="1"
					stroke-linejoin="round"
				/>
				<path
					d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
					fill="#f59e0b"
					stroke="#f59e0b"
					stroke-width="0.8"
					stroke-linejoin="round"
					clip-path={`url(#${idPrefix}-${i})`}
				/>
			</svg>
		))
	}
</span>
