---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? 'zh-tw') as Lang;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

const navLinks = [
	{ path: '', label: t('nav.home') },
	{ path: 'about', label: t('nav.about') },
	{ path: 'member', label: t('nav.member') },
	{ path: 'lecture', label: t('nav.lecture') },
	{ path: 'event', label: t('nav.event') },
];

const isActive = (path: string) => {
	const href = getRelativeLocaleUrl(lang, path);
	const here = pathname.replace(/\/$/, '') || '/';
	const target = href.replace(/\/$/, '') || '/';
	return path === ''
		? here === target
		: here === target || here.startsWith(`${target}/`);
};
---

<header
	id="navbar"
	class="sticky top-0 z-50 border-b border-chalk bg-paper transition-all duration-500"
>
	<nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
		<a
			href={getRelativeLocaleUrl(lang, '')}
			class="navbar-brand flex items-center gap-2.5 font-display font-bold text-ink tracking-tight hover:text-rust transition-colors duration-300"
		>
			<img src="/logo.png" alt="TTUSSC" class="h-6 w-6" />
			<span class="text-base">TTUSSC</span>
		</a>

		<ul class="hidden md:flex items-center gap-0.5">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={getRelativeLocaleUrl(lang, link.path)}
							class:list={[
								'px-3 py-1.5 text-[15px] font-medium rounded-md transition-all duration-200 hover:text-ink hover:bg-fog',
								isActive(link.path) ? 'text-ink bg-fog' : 'text-clay',
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden md:flex items-center gap-2">
			<a
				href="https://discord.com/invite/29PsKfe45h"
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-1.5 px-3.5 py-1.5 text-[13px] font-medium text-clay border border-chalk rounded-md hover:border-ink hover:text-ink transition-all duration-200"
			>
				<svg class="w-4 h-4 fill-ink" viewBox="0 0 640 512" aria-hidden="true">
					<path
						d="M524.5 69.8a1.5 1.5 0 0 0-.8-.7A485.1 485.1 0 0 0 404.1 32a1.8 1.8 0 0 0-1.9.9a337.5 337.5 0 0 0-14.9 30.6a447.8 447.8 0 0 0-134.4 0 309.5 309.5 0 0 0-15.1-30.6 1.9 1.9 0 0 0-1.9-.9a483.7 483.7 0 0 0-119.6 37.1 1.7 1.7 0 0 0-.8.7C39.1 183.7 18.2 294.7 28.4 404.4a2 2 0 0 0 .8 1.4A487.7 487.7 0 0 0 176 479.9a1.9 1.9 0 0 0 2.1-.7A348.2 348.2 0 0 0 208.1 430.4a1.9 1.9 0 0 0-1-2.6a321.2 321.2 0 0 1-45.9-21.9a1.9 1.9 0 0 1-.2-3.1c3.1-2.3 6.2-4.7 9.1-7.1a1.8 1.8 0 0 1 1.9-.3c96.2 43.9 200.4 43.9 295.5 0a1.8 1.8 0 0 1 1.9.2c2.9 2.4 6 4.9 9.1 7.2a1.9 1.9 0 0 1-.2 3.1a301.4 301.4 0 0 1-45.9 21.9a1.9 1.9 0 0 0-1 2.6a391.1 391.1 0 0 0 30 48.8a1.9 1.9 0 0 0 2.1.7A486 486 0 0 0 610.7 405.8a1.9 1.9 0 0 0 .8-1.4c12.2-126.9-20.5-236.9-86.9-334.6zM222.5 337.6c-28.9 0-52.8-26.6-52.8-59.3s23.4-59.3 52.8-59.3c29.7 0 53.4 26.9 52.8 59.3.1 32.7-23.3 59.3-52.8 59.3zm195.4 0c-28.9 0-52.8-26.6-52.8-59.3s23.4-59.3 52.8-59.3c29.7 0 53.4 26.9 52.8 59.3 0 32.7-23.2 59.3-52.8 59.3z"
					></path>
				</svg>
				Discord
			</a>
			<a
				href={getRelativeLocaleUrl(lang, 'sponsor')}
				class="px-3.5 py-1.5 text-[13px] font-medium bg-ink text-paper rounded-md hover:bg-ink-soft transition-all duration-200"
			>
				{t('nav.sponsor')}
			</a>
		</div>

		<button
			id="navbar-menu-toggle"
			class="md:hidden p-1.5 rounded-md hover:bg-fog transition-colors"
			aria-label="Menu"
			aria-expanded="false"
		>
			<svg
				id="navbar-icon-open"
				class="w-5 h-5 text-ink"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" d="M4 7h16M4 12h10M4 17h14"></path>
			</svg>
			<svg
				id="navbar-icon-close"
				class="hidden w-5 h-5 text-ink"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</nav>

	<div
		id="navbar-mobile-menu"
		class="hidden md:hidden border-t border-chalk bg-paper shadow-xl"
	>
		<div class="px-6 py-3 space-y-0.5">
			{
				navLinks.map((link) => (
					<a
						href={getRelativeLocaleUrl(lang, link.path)}
						class:list={[
							'block px-3 py-2 text-sm rounded-md transition-all hover:text-ink hover:bg-fog',
							isActive(link.path) ? 'text-ink bg-fog' : 'text-clay',
						]}
					>
						{link.label}
					</a>
				))
			}
			<div class="pt-3 flex gap-2">
				<a
					href="https://discord.com/invite/29PsKfe45h"
					target="_blank"
					rel="noopener noreferrer"
					class="flex-1 flex justify-center items-center gap-1.5 px-3 py-2 text-sm border border-chalk rounded-md text-ink"
				>
					Discord
				</a>
				<a
					href={getRelativeLocaleUrl(lang, 'sponsor')}
					class="flex-1 text-center px-3 py-2 text-sm bg-ink text-paper rounded-md"
				>
					{t('nav.sponsor')}
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const header = document.getElementById('navbar')!;
	const toggle = document.getElementById('navbar-menu-toggle')!;
	const mobileMenu = document.getElementById('navbar-mobile-menu')!;
	const iconOpen = document.getElementById('navbar-icon-open')!;
	const iconClose = document.getElementById('navbar-icon-close')!;
	const brand = document.querySelector<HTMLAnchorElement>('.navbar-brand')!;

	const setScrolled = (scrolled: boolean) => {
		header.classList.toggle('bg-paper/90', scrolled);
		header.classList.toggle('backdrop-blur-xl', scrolled);
		header.classList.toggle('border-chalk/80', scrolled);
	};
	window.addEventListener('scroll', () => setScrolled(window.scrollY > 20));

	let menuOpen = false;
	const setMenuOpen = (open: boolean) => {
		menuOpen = open;
		mobileMenu.classList.toggle('hidden', !open);
		iconOpen.classList.toggle('hidden', open);
		iconClose.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	};
	toggle.addEventListener('click', () => setMenuOpen(!menuOpen));
	mobileMenu
		.querySelectorAll('a')
		.forEach((a) => a.addEventListener('click', () => setMenuOpen(false)));

	let clickCount = 0;
	let lastClickTime = 0;
	brand.addEventListener('click', (event) => {
		// Already on the brand's target page: block the reload so repeated
		// clicks can accumulate toward the easter egg below.
		if (brand.pathname === location.pathname) event.preventDefault();
		const now = Date.now();
		if (now - lastClickTime > 10000) clickCount = 0;
		clickCount++;
		lastClickTime = now;
		if (clickCount === 10) {
			alert('ttussc{dont_h4ck_us_j0in_us}');
			clickCount = 0;
		}
	});
</script>
