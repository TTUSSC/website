---
import type { CollectionEntry } from 'astro:content';
import BlurImage from '../common/BlurImage.astro';

interface Props {
	heading: string;
	events: CollectionEntry<'events'>[];
	accentClass: string;
}

const { heading, events, accentClass } = Astro.props;
---

<div class="event-gallery scroll-reveal">
	<div class="flex items-center gap-3 mb-6">
		<span class:list={['w-8 h-0.5 rounded-full', accentClass]}></span>
		<h2 class="font-display text-xl md:text-2xl font-bold text-ink">
			{heading}
		</h2>
	</div>
	<div class="relative">
		<div
			class="gallery-scroll flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-3"
		>
			{
				events.map((event) => (
					<div class="hover-lift group relative overflow-hidden rounded-2xl bg-fog aspect-[4/3] cursor-pointer snap-start shrink-0 w-[76vw] md:w-[310px]">
						{event.data.image && (
							<BlurImage
								src={event.data.image}
								alt={event.data.name}
								width={310}
								class="w-full h-full object-cover"
								imgClass="transition-transform duration-500 group-hover:scale-105"
							/>
						)}
						<div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-transparent transition-all duration-300 group-hover:from-ink/75" />
						<div class="absolute bottom-0 left-0 right-0 px-3 pb-3">
							<p class="text-white/70 text-[11px] drop-shadow">
								{event.data.date.toISOString().slice(0, 10)}
							</p>
							<p class="text-white font-display font-semibold text-sm drop-shadow">
								{event.data.name}
							</p>
							{event.data.desc && (
								<p class="text-white/80 text-xs mt-0.5 opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
									{event.data.desc}
								</p>
							)}
						</div>
					</div>
				))
			}
		</div>
		<button
			type="button"
			class="gallery-prev hidden md:flex absolute -left-5 top-[calc(50%-1.25rem)] -translate-y-1/2 w-9 h-9 items-center justify-center rounded-full bg-paper/90 shadow border border-chalk text-ink hover:bg-paper transition-all duration-200 z-10"
			aria-label="向左滑"
		>
			<svg
				class="w-4 h-4"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" d="M15 19l-7-7 7-7"></path>
			</svg>
		</button>
		<button
			type="button"
			class="gallery-next hidden md:flex absolute -right-5 top-[calc(50%-1.25rem)] -translate-y-1/2 w-9 h-9 items-center justify-center rounded-full bg-paper/90 shadow border border-chalk text-ink hover:bg-paper transition-all duration-200 z-10"
			aria-label="向右滑"
		>
			<svg
				class="w-4 h-4"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" d="M9 5l7 7-7 7"></path>
			</svg>
		</button>
	</div>
</div>

<style>
	.gallery-scroll {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.gallery-scroll::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	// Astro dedupes identical inline module scripts to one execution per
	// page even when this component renders multiple times, so this must
	// wire up every `.event-gallery` instance on the page in one pass
	// rather than assuming a single instance.
	document
		.querySelectorAll<HTMLDivElement>('.event-gallery')
		.forEach((gallery) => {
			const scrollEl = gallery.querySelector<HTMLDivElement>('.gallery-scroll');
			const prevBtn = gallery.querySelector<HTMLButtonElement>('.gallery-prev');
			const nextBtn = gallery.querySelector<HTMLButtonElement>('.gallery-next');
			prevBtn?.addEventListener('click', () =>
				scrollEl?.scrollBy({ left: -330, behavior: 'smooth' }),
			);
			nextBtn?.addEventListener('click', () =>
				scrollEl?.scrollBy({ left: 330, behavior: 'smooth' }),
			);
		});
</script>
