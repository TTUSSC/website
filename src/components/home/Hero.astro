---
import { getLang } from '../../i18n/ui';

const content = {
	'zh-tw': {
		headline: '科學開源服務社',
		description:
			'致力於推廣開源文化、技術學習與志工服務。透過社課與講座學習開源工具，專案實作累積經驗，並參與資訊營隊與研討會志工。',
		joinCta: '加入我們',
		staffCta: '幹部召集令',
	},
} as const;

const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
---

<section
	class="noise-bg relative overflow-hidden min-h-[calc(100vh-3.5rem)] flex items-center py-16 md:py-0"
>
	<div class="relative z-10 max-w-5xl mx-auto px-6 w-full md:-mt-8">
		<div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
			<div class="md:col-span-8">
				<div class="reveal flex items-center gap-3 mb-4 md:mb-6">
					<span
						class="inline-block px-2.5 py-1 text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-rust border border-rust/30 rounded-sm"
					>
						Open Source Club
					</span>
					<div class="flex items-center gap-2">
						<a
							href="https://discord.com/invite/29PsKfe45h"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Discord"
							class="text-sand hover:text-[#5865F2] transition-colors duration-200"
						>
							<svg
								class="w-4 h-4 fill-current"
								viewBox="0 0 640 512"
								aria-hidden="true"
							>
								<path
									d="M524.5 69.8a1.5 1.5 0 0 0-.8-.7A485.1 485.1 0 0 0 404.1 32a1.8 1.8 0 0 0-1.9.9 337.5 337.5 0 0 0-14.9 30.6 447.8 447.8 0 0 0-134.4 0 309.5 309.5 0 0 0-15.1-30.6 1.9 1.9 0 0 0-1.9-.9 483.7 483.7 0 0 0-119.6 37.1 1.7 1.7 0 0 0-.8.7C39.1 183.7 18.2 294.7 28.4 404.4a2 2 0 0 0 .8 1.4A487.7 487.7 0 0 0 176 479.9a1.9 1.9 0 0 0 2.1-.7A348.2 348.2 0 0 0 208.1 430.4a1.9 1.9 0 0 0-1-2.6 321.2 321.2 0 0 1-45.9-21.9 1.9 1.9 0 0 1-.2-3.1c3.1-2.3 6.2-4.7 9.1-7.1a1.8 1.8 0 0 1 1.9-.3c96.2 43.9 200.4 43.9 295.5 0a1.8 1.8 0 0 1 1.9.2c2.9 2.4 6 4.9 9.1 7.2a1.9 1.9 0 0 1-.2 3.1 301.4 301.4 0 0 1-45.9 21.9 1.9 1.9 0 0 0-1 2.6 391.1 391.1 0 0 0 30 48.8 1.9 1.9 0 0 0 2.1.7A486 486 0 0 0 610.7 405.8a1.9 1.9 0 0 0 .8-1.4c12.2-126.9-20.5-236.9-86.9-334.6zM222.5 337.6c-28.9 0-52.8-26.6-52.8-59.3s23.4-59.3 52.8-59.3c29.7 0 53.4 26.9 52.8 59.3.1 32.7-23.3 59.3-52.8 59.3zm195.4 0c-28.9 0-52.8-26.6-52.8-59.3s23.4-59.3 52.8-59.3c29.7 0 53.4 26.9 52.8 59.3 0 32.7-23.2 59.3-52.8 59.3z"
								></path>
							</svg>
						</a>
						<a
							href="https://www.facebook.com/ttussc/"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Facebook"
							class="text-sand hover:text-[#1877F2] transition-colors duration-200"
						>
							<svg
								class="w-4 h-4 fill-current"
								viewBox="0 0 512 512"
								aria-hidden="true"
							>
								<path
									d="M512 256C512 114.6 397.4 0 256 0S0 114.6 0 256C0 376 82.7 476.8 194.2 504.5V334.2H141.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H287V510.1C413.8 494.8 512 386.9 512 256h0z"
								></path>
							</svg>
						</a>
						<a
							href="https://instagram.com/ttussc_/"
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Instagram"
							class="text-sand hover:text-[#E1306C] transition-colors duration-200"
						>
							<svg
								class="w-4 h-4 fill-current"
								viewBox="0 0 448 512"
								aria-hidden="true"
							>
								<path
									d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
								></path>
							</svg>
						</a>
					</div>
				</div>
				<h1
					class="reveal reveal-d1 font-display text-[clamp(3.2rem,9vw,6rem)] font-extrabold text-ink leading-tight tracking-tight whitespace-nowrap"
				>
					{t.headline}
				</h1>
				<p
					class="reveal reveal-d2 mt-4 md:mt-8 text-sm md:text-lg text-clay leading-relaxed max-w-md"
				>
					{t.description}
				</p>
				<div class="reveal reveal-d3 mt-8 flex flex-wrap gap-3">
					<a
						href="https://forms.gle/GWUsti9y7igNq9gXA"
						target="_blank"
						rel="noopener noreferrer"
						class="group inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-paper text-sm font-medium rounded-md hover:bg-ink-soft transition-colors duration-300"
					>
						{t.joinCta}
						<svg
							class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" d="M5 12h14m-4-4l4 4-4 4"></path>
						</svg>
					</a>
					<a
						href="https://forms.gle/nfnLuF2F2kBCH9AKA"
						target="_blank"
						rel="noopener noreferrer"
						class="group inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium bg-rust text-paper rounded-md hover:opacity-90 transition-opacity duration-200"
					>
						{t.staffCta}
						<svg
							class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" d="M5 12h14m-4-4l4 4-4 4"></path>
						</svg>
					</a>
				</div>
			</div>
			<div class="reveal reveal-d4 md:col-span-4 flex justify-center">
				<div class="relative translate-y-4 md:translate-y-6">
					<div class="absolute -inset-8 bg-rust/5 rounded-full blur-3xl"></div>
					<img
						src="/logo.png"
						alt="TTUSSC"
						class="relative w-48 h-48 md:w-64 md:h-64 object-contain"
					/>
				</div>
			</div>
		</div>
	</div>
	<div
		class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-sand/60"
	>
		<span class="text-[10px] uppercase tracking-widest">Scroll</span>
		<svg
			class="w-4 h-4 animate-bounce"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<path stroke-linecap="round" d="M19 9l-7 7-7-7"></path>
		</svg>
	</div>
	<div
		class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-chalk to-transparent"
	>
	</div>
</section>
