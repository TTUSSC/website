---
import { Image } from 'astro:assets';
import { getLang } from '../../i18n/ui';
import activity1 from '../../assets/home/activity-1.jpg';
import activity2 from '../../assets/home/activity-2.jpg';
import activity3 from '../../assets/home/activity-3.jpg';
import activityWave from '../../assets/home/activity-wave.png';

const images = [activity1, activity2, activity3];

const content = {
	'zh-tw': {
		label: '活動精選',
		heading: '回顧我們的足跡',
		moreLink: '查看更多活動照片',
		photos: [
			{
				alt: '最近社課',
				desc: '20260402 從 0 開始的前端實作：JavaScript 記帳系統',
			},
			{ alt: '營隊活動', desc: '2026 小小創客大冒險 - ARDUINO冬日創客營' },
			{ alt: '開源社群', desc: '20260328 SITCON' },
		],
	},
} as const;

const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
const photos = t.photos.map((photo, i) => ({ ...photo, img: images[i] }));
---

<section class="py-20 md:py-28">
	<div class="max-w-5xl mx-auto px-6">
		<div class="mb-10 scroll-reveal">
			<span
				class="text-[11px] uppercase tracking-[0.2em] text-rust font-semibold"
				>{t.label}</span
			>
			<h2 class="mt-2 text-3xl md:text-4xl font-bold text-ink">{t.heading}</h2>
		</div>

		<div class="relative">
			<div class="carousel scroll-reveal flex h-[360px] md:h-[460px]">
				<div class="flex flex-col shrink-0 w-32 md:w-40 h-full">
					{
						photos.map((photo) => (
							<button
								type="button"
								class="carousel-tab flex-1 relative text-left px-4 md:px-5 rounded-l-xl transition-all duration-300 select-none flex items-center bg-[#e8e4dc] text-clay hover:bg-chalk"
								aria-label={photo.alt}
							>
								<span class="text-sm md:text-[15px] font-display font-semibold leading-tight">
									{photo.alt}
								</span>
							</button>
						))
					}
				</div>

				<div
					class="carousel-viewport flex-1 relative overflow-hidden rounded-r-2xl bg-fog"
				>
					{
						photos.map((photo, i) => (
							<div
								class="carousel-slide absolute inset-0"
								class:list={{ 'is-current': i === 0 }}
							>
								<Image
									src={photo.img}
									alt={photo.alt}
									class="w-full h-full object-cover"
								/>
								<div class="absolute inset-0 bg-linear-to-t from-ink/70 via-ink/10 to-transparent" />
								<div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
									<span class="text-white font-display font-bold text-xl md:text-2xl drop-shadow">
										{photo.alt}
									</span>
									<p class="mt-1 text-white/75 text-sm leading-relaxed max-w-sm">
										{photo.desc}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class="absolute bottom-0 -right-4 md:-right-6 flex items-end gap-3">
				<a
					href="https://instagram.com/ttussc_/"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-1 text-white/70 hover:text-white text-xs transition-colors duration-200 group mb-3 whitespace-nowrap drop-shadow"
				>
					{t.moreLink}
					<svg
						class="w-3 h-3 group-hover:translate-x-0.5 transition-transform"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path stroke-linecap="round" d="M5 12h14m-4-4l4 4-4 4"></path>
					</svg>
				</a>
				<Image
					src={activityWave}
					alt="wave"
					class="w-16 md:w-20 select-none pointer-events-none drop-shadow-sm shrink-0 -mb-2"
				/>
			</div>
		</div>
	</div>
</section>

<script>
	const carousel = document.querySelector<HTMLDivElement>('.carousel')!;
	const tabs = Array.from(
		carousel.querySelectorAll<HTMLButtonElement>('.carousel-tab'),
	);
	const slides = Array.from(
		carousel.querySelectorAll<HTMLDivElement>('.carousel-slide'),
	);
	const INTERVAL_MS = 4000;

	let current = 0;
	let timer: ReturnType<typeof setInterval> | null = null;

	const goTo = (index: number) => {
		current = index;
		tabs.forEach((tab, i) => {
			const isCurrent = i === current;
			tab.classList.toggle('bg-ink', isCurrent);
			tab.classList.toggle('text-paper', isCurrent);
			tab.classList.toggle('z-10', isCurrent);
			tab.classList.toggle('bg-[#e8e4dc]', !isCurrent);
			tab.classList.toggle('text-clay', !isCurrent);
		});
		slides.forEach((slide, i) =>
			slide.classList.toggle('is-current', i === current),
		);
	};

	const next = () => goTo((current + 1) % slides.length);

	const stop = () => {
		if (timer) clearInterval(timer);
		timer = null;
	};
	const start = () => {
		stop();
		timer = setInterval(next, INTERVAL_MS);
	};

	tabs.forEach((tab, i) =>
		tab.addEventListener('click', () => {
			goTo(i);
			start();
		}),
	);
	carousel.addEventListener('mouseenter', stop);
	carousel.addEventListener('mouseleave', start);

	goTo(0);
	start();
</script>
