---
import { Image } from 'astro:assets';
import { getLang } from '../../i18n/ui';
import activity1 from '../../assets/home/activity-1.jpg';
import activity2 from '../../assets/home/activity-2.jpg';
import activity3 from '../../assets/home/activity-3.jpg';
import activityWave from '../../assets/home/activity-wave.png';

const images = [activity1, activity2, activity3];

const content = {
	'zh-tw': {
		label: '活動精選',
		heading: '回顧我們的足跡',
		moreLink: '查看更多活動照片',
		photos: [
			{
				alt: '最近社課',
				desc: '20260402 從 0 開始的前端實作：JavaScript 記帳系統',
			},
			{ alt: '營隊活動', desc: '2026 小小創客大冒險 - ARDUINO冬日創客營' },
			{ alt: '社群活動', desc: '20260328 SITCON' },
		],
	},
	en: {
		label: 'Featured Events',
		heading: 'Looking Back on Our Journey',
		moreLink: 'See more event photos',
		photos: [
			{
				alt: 'Recent Lectures',
				desc: '20260402 從 0 開始的前端實作：JavaScript 記帳系統',
			},
			{ alt: 'Camps', desc: '2026 小小創客大冒險 - ARDUINO冬日創客營' },
			{ alt: 'Community Events', desc: '20260328 SITCON' },
		],
	},
} as const;

const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
const photos = t.photos.map((photo, i) => ({ ...photo, img: images[i] }));
---

<section class="py-20 md:py-28">
	<div class="max-w-5xl mx-auto px-6">
		<div class="mb-10 scroll-reveal">
			<span
				class="text-[11px] uppercase tracking-[0.2em] text-rust font-semibold"
				>{t.label}</span
			>
			<h2 class="mt-2 text-3xl md:text-4xl font-bold text-ink">{t.heading}</h2>
		</div>

		<div class="carousel scroll-reveal">
			<div class="flex flex-wrap gap-2 mb-4">
				{
					photos.map((photo, i) => (
						<button
							type="button"
							class:list={[
								'carousel-tab px-3 py-1.5 text-xs font-display font-medium rounded-md transition-all duration-200',
								i === 0
									? 'bg-ink text-paper'
									: 'text-clay border border-chalk hover:border-ink hover:text-ink',
							]}
							data-alt={photo.alt}
							data-desc={photo.desc}
							aria-label={photo.alt}
						>
							{photo.alt}
						</button>
					))
				}
			</div>

			<div class="relative rounded-2xl overflow-hidden bg-fog aspect-[16/9]">
				{
					photos.map((photo, i) => (
						<div
							class="carousel-slide absolute inset-0"
							class:list={{ 'is-current': i === 0 }}
						>
							<Image
								src={photo.img}
								alt={photo.alt}
								class="w-full h-full object-cover"
							/>
						</div>
					))
				}
				<div
					class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/55 via-ink/10 to-transparent px-5 py-4 md:px-6 md:py-5"
				>
					<p
						class="carousel-caption-title font-display font-bold text-base md:text-lg text-white drop-shadow"
					>
						{photos[0].alt}
					</p>
					<p
						class="carousel-caption-desc mt-0.5 text-xs md:text-sm text-white/80 leading-relaxed"
					>
						{photos[0].desc}
					</p>
				</div>
			</div>

			<div class="mt-4 flex justify-end">
				<div class="flex items-end gap-3 shrink-0">
					<a
						href="https://instagram.com/ttussc_/"
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1 text-clay hover:text-ink text-xs transition-colors duration-200 group whitespace-nowrap"
					>
						{t.moreLink}
						<svg
							class="w-3 h-3 group-hover:translate-x-0.5 transition-transform"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" d="M5 12h14m-4-4l4 4-4 4"></path>
						</svg>
					</a>
					<Image
						src={activityWave}
						alt=""
						width={160}
						class="w-14 md:w-16 select-none pointer-events-none drop-shadow-sm shrink-0"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const carousel = document.querySelector<HTMLDivElement>('.carousel')!;
	const tabs = Array.from(
		carousel.querySelectorAll<HTMLButtonElement>('.carousel-tab'),
	);
	const slides = Array.from(
		carousel.querySelectorAll<HTMLDivElement>('.carousel-slide'),
	);
	const captionTitle = carousel.querySelector<HTMLParagraphElement>(
		'.carousel-caption-title',
	)!;
	const captionDesc = carousel.querySelector<HTMLParagraphElement>(
		'.carousel-caption-desc',
	)!;
	const INTERVAL_MS = 4000;

	let current = 0;
	let timer: ReturnType<typeof setInterval> | null = null;

	const goTo = (index: number) => {
		current = index;
		tabs.forEach((tab, i) => {
			const isCurrent = i === current;
			tab.classList.toggle('bg-ink', isCurrent);
			tab.classList.toggle('text-paper', isCurrent);
			tab.classList.toggle('border', !isCurrent);
			tab.classList.toggle('border-chalk', !isCurrent);
			tab.classList.toggle('text-clay', !isCurrent);
		});
		slides.forEach((slide, i) =>
			slide.classList.toggle('is-current', i === current),
		);
		captionTitle.textContent = tabs[current].dataset.alt ?? '';
		captionDesc.textContent = tabs[current].dataset.desc ?? '';
	};

	const next = () => goTo((current + 1) % slides.length);

	const stop = () => {
		if (timer) clearInterval(timer);
		timer = null;
	};
	const start = () => {
		stop();
		timer = setInterval(next, INTERVAL_MS);
	};

	tabs.forEach((tab, i) =>
		tab.addEventListener('click', () => {
			goTo(i);
			start();
		}),
	);
	carousel.addEventListener('mouseenter', stop);
	carousel.addEventListener('mouseleave', start);

	goTo(0);
	start();
</script>
