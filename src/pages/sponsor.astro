---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang } from '../i18n/ui';

// Emoji and accent color aren't text, so they stay outside the content dict
// and get zipped onto the translated tier data by index below.
const tierMeta = [
	{ emoji: '🔹', color: '#7c9bb5' },
	{ emoji: '🟫', color: '#a0744a' },
	{ emoji: '⚪', color: '#8a9aaa' },
	{ emoji: '🟡', color: '#c9922a' },
	{ emoji: '🔵', color: '#5c85bd' },
	{ emoji: '💎', color: '#7c5cbf' },
];

const content = {
	'zh-tw': {
		title: '贊助我們｜科學開源服務社',
		description:
			'贊助金額請以百元為單位進行贊助。您的每一分支持，都是社團繼續前行的動力。',
		eyebrow: 'Sponsor Us',
		heading: '個人贊助方案',
		subtitle:
			'贊助金額請以百元為單位進行贊助。您的每一分支持，都是社團繼續前行的動力。',
		benefitsLabel: '🎁 回饋內容',
		forLabel: '適合：',
		contactIntro: '若您有任何贊助相關問題，歡迎透過',
		contactOr: '或',
		contactOutro: '與我們聯繫。',
		tiers: [
			{
				name: '一般支持者',
				range: '100 – 400 元',
				quote: '你的力量微小，卻足以點亮黑暗中的第一盞火。',
				for: '想小額支持、希望看到社團持續發展的人',
				benefits: [
					'期末大會感謝名單（電子）',
					'Discord 支持者身分組（Basic Supporter）',
					'受邀參與社團期初、期末大會',
				],
			},
			{
				name: '青銅支持者',
				range: '500 – 900 元',
				quote: '你的援助如同青銅之盾，為我們擋下最初的風與雨。',
				for: '想真正參與社團文化的人',
				benefits: ['之前的所有回饋內容', '購買社團周邊享有折扣', '電子感謝狀'],
			},
			{
				name: '白銀支持者',
				range: '1,000 – 4,900 元',
				quote: '你賜予的銀光，使我們能在知識的迷霧中看得更遠。',
				for: '希望具體提升設備／教材的人',
				benefits: [
					'之前的所有回饋內容',
					'優先購買新上架的社團周邊',
					'社團活動優先參與權',
				],
			},
			{
				name: '黃金支持者',
				range: '5,000 – 9,900 元',
				quote: '你的黃金祝福讓計畫的齒輪運轉得比命運還要精準。',
				for: '社團核心贊助者，有興趣深度參與活動',
				benefits: [
					'之前的所有回饋內容',
					'實體感謝狀（期初、期末頒發）',
					'可指定贊助項目（贊助款項將有超過一半用於您指定的項目）',
				],
			},
			{
				name: '白金支持者',
				range: '10,000 – 19,900 元',
				quote: '你是白金之翼，帶我們越過技術的壁障，抵達更高的天空。',
				for: '想長期支持社團教育願景的人',
				benefits: [
					'之前的所有回饋內容',
					'名字將出現在社網的特別感謝名單中（可匿名）',
					'受邀於社團期初、期末大會致詞',
				],
			},
			{
				name: '鑽石支持者',
				range: '20,000 元以上',
				quote: '你的意志堅若鑽石，是足以改寫未來軌跡的神域之力。',
				for: '對教育、開源、科技傳承，有高度熱情的人',
				benefits: [
					'之前的所有回饋內容',
					'可在社團成員能力範圍內指定一項社團活動的主題',
					'全體社團幹部拍影片致謝',
				],
			},
		],
	},
	en: {
		title: 'Sponsor Us | TTUSSC',
		description:
			'Sponsorships are made in units of NT$100. Every bit of support you give keeps the club moving forward.',
		eyebrow: 'Sponsor Us',
		heading: 'Individual Sponsorship Tiers',
		subtitle:
			'Sponsorships are made in units of NT$100. Every bit of support you give keeps the club moving forward.',
		benefitsLabel: '🎁 Perks',
		forLabel: 'Best for: ',
		contactIntro:
			'If you have any questions about sponsorship, feel free to reach us via',
		contactOr: 'or',
		contactOutro: '.',
		tiers: [
			{
				name: 'Supporter',
				range: 'NT$100 – 400',
				quote:
					"Your strength may be small, but it's enough to light the first flame in the dark.",
				for: 'Anyone who wants to give a small amount and see the club keep growing',
				benefits: [
					'Thank-you list at the year-end assembly (digital)',
					'Discord supporter role (Basic Supporter)',
					"Invitation to the club's opening and closing assemblies",
				],
			},
			{
				name: 'Bronze Supporter',
				range: 'NT$500 – 900',
				quote:
					'Your aid is a bronze shield, warding off the first winds and rains for us.',
				for: "Anyone who wants to truly take part in the club's culture",
				benefits: [
					'All previous perks',
					'Discount on club merchandise',
					'Digital certificate of appreciation',
				],
			},
			{
				name: 'Silver Supporter',
				range: 'NT$1,000 – 4,900',
				quote:
					'The silver light you grant lets us see further through the fog of knowledge.',
				for: 'Anyone who wants to help concretely improve our equipment and materials',
				benefits: [
					'All previous perks',
					'Priority access to new club merchandise',
					'Priority registration for club events',
				],
			},
			{
				name: 'Gold Supporter',
				range: 'NT$5,000 – 9,900',
				quote:
					'Your golden blessing turns the gears of our plans more precisely than fate itself.',
				for: 'Core sponsors of the club interested in deep involvement in our activities',
				benefits: [
					'All previous perks',
					'Physical certificate of appreciation (presented at the opening and closing assemblies)',
					'Ability to designate a sponsorship focus (over half of your contribution will go toward the project you choose)',
				],
			},
			{
				name: 'Platinum Supporter',
				range: 'NT$10,000 – 19,900',
				quote:
					'You are our platinum wings, carrying us over the barriers of technology to greater heights.',
				for: "Anyone who wants to support the club's educational vision long-term",
				benefits: [
					'All previous perks',
					'Your name listed in the special thanks section of our website (anonymity available)',
					"Invitation to speak at the club's opening and closing assemblies",
				],
			},
			{
				name: 'Diamond Supporter',
				range: 'NT$20,000+',
				quote:
					'Your resolve is as unyielding as diamond — a force from another realm strong enough to reshape the future.',
				for: 'Anyone with a deep passion for education, open source, and passing on technology',
				benefits: [
					'All previous perks',
					"Ability to choose the theme of one club event, within the club's means",
					'A thank-you video from the entire club leadership team',
				],
			},
		],
	},
} as const;

const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
const tiers = t.tiers.map((tier, i) => ({ ...tier, ...tierMeta[i] }));
---

<BaseLayout title={t.title} description={t.description}>
	<div class="max-w-3xl mx-auto px-6 py-20 md:py-28">
		<div class="mb-14 reveal">
			<span
				class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-rust"
			>
				{t.eyebrow}
			</span>
			<h1
				class="font-display text-3xl md:text-4xl font-bold text-ink mt-2 mb-4 flex items-center gap-3"
			>
				<span
					class="flex items-center justify-center w-10 h-10 rounded-full bg-rust/10"
				>
					<svg
						class="w-5 h-5 text-rust"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
						></path>
					</svg>
				</span>
				{t.heading}
			</h1>
			<p class="text-clay text-base leading-relaxed max-w-2xl">
				{t.subtitle}
			</p>
		</div>

		<div
			class="h-px bg-linear-to-r from-transparent via-chalk to-transparent mb-14"
		>
		</div>

		<div class="space-y-6">
			{
				tiers.map((tier) => (
					<div class="reveal group relative rounded-2xl border border-chalk bg-paper hover:border-clay/40 transition-all duration-300 overflow-hidden">
						<div
							class="absolute left-0 top-0 bottom-0 w-1 rounded-l-2xl"
							style={{ background: tier.color }}
						/>

						<div class="pl-6 pr-5 py-6">
							<div class="flex items-start justify-between gap-4 mb-3">
								<div>
									<span class="text-xl">{tier.emoji}</span>
									<span class="ml-2 font-display font-bold text-ink text-lg">
										{tier.name}
									</span>
								</div>
								<span
									class="shrink-0 text-[12px] font-mono font-semibold px-2.5 py-1 rounded-full border"
									style={{
										color: tier.color,
										borderColor: `${tier.color}55`,
										background: `${tier.color}12`,
									}}
								>
									{tier.range}
								</span>
							</div>

							<p
								class="text-[13px] text-clay/80 italic leading-relaxed mb-4 border-l-2 pl-3"
								style={{ borderColor: `${tier.color}80` }}
							>
								{tier.quote}
							</p>

							<p class="text-[13px] text-clay mb-4">
								<span class="font-medium text-ink">{t.forLabel}</span>
								{tier.for}
							</p>

							<div>
								<p class="text-[12px] uppercase tracking-[0.15em] font-semibold text-sand mb-2">
									{t.benefitsLabel}
								</p>
								<ul class="space-y-1.5">
									{tier.benefits.map((benefit) => (
										<li class="flex items-start gap-2 text-[13px] text-clay leading-relaxed">
											<span class="shrink-0 w-1 h-1 rounded-full bg-clay/40 mt-[7px]" />
											{benefit}
										</li>
									))}
								</ul>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-14 text-center">
			<div
				class="h-px bg-linear-to-r from-transparent via-chalk to-transparent mb-8"
			>
			</div>
			<p class="text-sm text-clay leading-relaxed">
				{t.contactIntro}
				<a
					href="https://discord.com/invite/29PsKfe45h"
					target="_blank"
					rel="noopener noreferrer"
					class="text-ink underline underline-offset-2 hover:text-rust transition-colors"
				>
					Discord
				</a>
				{t.contactOr}
				<a
					href="https://www.facebook.com/ttussc/"
					target="_blank"
					rel="noopener noreferrer"
					class="text-ink underline underline-offset-2 hover:text-rust transition-colors"
				>
					Facebook
				</a>
				{t.contactOutro}
			</p>
		</div>
	</div>
</BaseLayout>
