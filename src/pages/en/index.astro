>
	<div class="max-w-5xl mx-auto px-6 py-24">
		<h1 class="text-3xl font-display font-bold">
			Home (content added in phase 2)
		</h1>
		<a href={zhUrl}>繁體中文</a>
	</div>
</BaseLayout>
