---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DifficultyStars from '../../../components/lectures/DifficultyStars.astro';
import LectureTimeline from '../../../components/lectures/LectureTimeline.astro';
import { getLang } from '../../../i18n/ui';

export async function getStaticPaths() {
	const lectures = await getCollection('lectures');
	return lectures.map((entry) => {
		const [semester] = entry.id.split('/');
		return {
			params: { semester, slug: entry.data.slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const content = {
	'zh-tw': { slide: '簡報', cowrite: '共筆', slido: 'Slido', kktix: 'KKTIX' },
} as const;
const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];

const links = (
	[
		{ label: t.slide, href: data.slide },
		{ label: t.cowrite, href: data.cowrite },
		{ label: t.slido, href: data.slido },
		{ label: t.kktix, href: data.kktix },
	] as { label: string; href: string | undefined }[]
).filter((link): link is { label: string; href: string } => Boolean(link.href));
---

<BaseLayout title={data.name} description={`TTUSSC 社課：${data.name}`}>
	<article class="max-w-3xl mx-auto px-6 py-20 md:py-24">
		<span
			class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-moss"
		>
			{
				data.date.toLocaleDateString('zh-TW', {
					month: 'long',
					day: 'numeric',
				})
			}
		</span>
		<h1 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2 mb-4">
			{data.name}
		</h1>

		<div class="flex items-center gap-3 flex-wrap mb-6">
			<DifficultyStars
				difficulty={data.difficulty}
				idPrefix={`detail-${data.slug}`}
				size="md"
			/>
			<span class="text-sm text-sand">{data.lecturer}</span>
			<span
				class:list={[
					'px-2 py-0.5 text-xs rounded-sm',
					data.type === '主線'
						? 'bg-moss/10 text-moss'
						: 'bg-rust/10 text-rust',
				]}
			>
				{data.type}
			</span>
		</div>

		{
			data.location && (
				<div class="flex items-center gap-2 text-[14px] text-clay mb-4">
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
						/>
						<path
							stroke-linecap="round"
							d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
						/>
					</svg>
					{data.location}
				</div>
			)
		}

		<div class="prose prose-sm md:prose-base max-w-none text-ink/90 mb-6">
			<Content />
		</div>

		{
			data.tags.length > 0 && (
				<div class="flex flex-wrap gap-1.5 mb-8">
					{data.tags.map((tag) => (
						<span class="px-2.5 py-0.5 text-xs md:text-sm bg-fog text-clay rounded-sm">
							#{tag}
						</span>
					))}
				</div>
			)
		}

		{data.timeline && <LectureTimeline items={data.timeline} />}

		{
			links.length > 0 && (
				<div class="flex flex-wrap gap-2 pt-6">
					{links.map((link) => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							class="text-sm px-3.5 py-2 border border-chalk rounded-md text-rust hover:bg-rust/5 transition-colors"
						>
							{link.label} →
						</a>
					))}
				</div>
			)
		}
	</article>
</BaseLayout>
