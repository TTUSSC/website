---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SemesterLectureList from '../../../components/lectures/SemesterLectureList.astro';

export async function getStaticPaths() {
	const lectures = await getCollection('lectures');
	const bySemester = new Map<string, typeof lectures>();
	for (const entry of lectures) {
		const [semester] = entry.id.split('/');
		if (!bySemester.has(semester)) bySemester.set(semester, []);
		bySemester.get(semester)!.push(entry);
	}
	const allSemesters = [...bySemester.keys()].sort().reverse();

	return [...bySemester.entries()].flatMap(([semester, semesterEntries]) => {
		const entries = semesterEntries.sort(
			(a, b) => b.data.date.getTime() - a.data.date.getTime(),
		);
		return entries.map((entry) => ({
			params: { semester, slug: entry.data.slug },
			props: { entries, allSemesters, slug: entry.data.slug },
		}));
	});
}

interface Props {
	entries: Awaited<ReturnType<typeof getCollection<'lectures'>>>;
	allSemesters: string[];
	slug: string;
}

const { semester } = Astro.params as { semester: string };
const { entries, allSemesters, slug } = Astro.props as Props;
const entry = entries.find((e) => e.data.slug === slug)!;
---

<BaseLayout
	title={entry.data.name}
	description={`TTUSSC 社課：${entry.data.name}`}
>
	<SemesterLectureList
		semester={semester}
		entries={entries}
		allSemesters={allSemesters}
		openSlug={slug}
	/>
</BaseLayout>
