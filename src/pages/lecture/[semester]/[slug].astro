---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SemesterLectureList from '../../../components/lectures/SemesterLectureList.astro';
import { groupLecturesBySemester } from '../../../lib/lectures';
import { getLang } from '../../../i18n/ui';

export async function getStaticPaths() {
	const { bySemester, allSemesters } = await groupLecturesBySemester();

	return [...bySemester.entries()].flatMap(([semester, entries]) =>
		entries.map((entry) => ({
			params: { semester, slug: entry.data.slug },
			props: { entries, allSemesters, slug: entry.data.slug },
		})),
	);
}

interface Props {
	entries: CollectionEntry<'lectures'>[];
	allSemesters: string[];
	slug: string;
}

const { semester } = Astro.params as { semester: string };
const { entries, allSemesters, slug } = Astro.props as Props;
const entry = entries.find((e) => e.data.slug === slug)!;

const content = {
	'zh-tw': {
		fallbackDescription: (name: string) => `TTUSSC 社課：${name}`,
	},
} as const;
const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];

/** Derives a short plain-text excerpt from the lecture's Markdown body. */
function excerptFrom(body: string | undefined): string | undefined {
	const plain = (body ?? '').trim().replace(/\s+/g, ' ');
	if (!plain) return undefined;
	const limit = 120;
	if (plain.length <= limit) return plain;
	return `${plain.slice(0, limit).trimEnd()}…`;
}

const description =
	excerptFrom(entry.body) ?? t.fallbackDescription(entry.data.name);
---

<BaseLayout title={entry.data.name} description={description}>
	<SemesterLectureList
		semester={semester}
		entries={entries}
		allSemesters={allSemesters}
		openSlug={slug}
	/>
</BaseLayout>
