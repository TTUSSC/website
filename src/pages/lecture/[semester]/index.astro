---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SemesterLectureList from '../../../components/lectures/SemesterLectureList.astro';
import { groupLecturesBySemester } from '../../../lib/lectures';

function semesterLabel(semester: string): string {
	const [year, term] = semester.split('-');
	return `${year} ${term === '1' ? '上' : '下'}學期`;
}

export async function getStaticPaths() {
	const { bySemester, allSemesters } = await groupLecturesBySemester();

	return allSemesters.map((semester) => ({
		params: { semester },
		props: {
			entries: bySemester.get(semester)!,
			allSemesters,
		},
	}));
}

interface Props {
	entries: Awaited<ReturnType<typeof getCollection<'lectures'>>>;
	allSemesters: string[];
}

const { semester } = Astro.params as { semester: string };
const { entries, allSemesters } = Astro.props as Props;
---

<BaseLayout
	title={`社課｜${semesterLabel(semester)}`}
	description="學長姐手把手教學，搭配業界前輩實戰分享。"
>
	<SemesterLectureList
		semester={semester}
		entries={entries}
		allSemesters={allSemesters}
	/>
</BaseLayout>
