---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SemesterLectureList from '../../../components/lectures/SemesterLectureList.astro';
import { groupLecturesBySemester, semesterLabel } from '../../../lib/lectures';
import { getLang } from '../../../i18n/ui';

export async function getStaticPaths() {
	const { bySemester, allSemesters } = await groupLecturesBySemester();

	return allSemesters.map((semester) => ({
		params: { semester },
		props: {
			entries: bySemester.get(semester)!,
			allSemesters,
		},
	}));
}

interface Props {
	entries: CollectionEntry<'lectures'>[];
	allSemesters: string[];
}

const { semester } = Astro.params as { semester: string };
const { entries, allSemesters } = Astro.props as Props;

const content = {
	'zh-tw': {
		titlePrefix: '社課',
		description: '學長姐手把手教學，搭配業界前輩實戰分享。',
		titleSeparator: '｜',
	},
	en: {
		titlePrefix: 'Lectures',
		description:
			'Hands-on teaching from senior members, paired with real-world sharing from industry mentors.',
		titleSeparator: ' | ',
	},
} as const;
const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
---

<BaseLayout
	title={`${t.titlePrefix}${t.titleSeparator}${semesterLabel(semester, lang)}`}
	description={t.description}
>
	<SemesterLectureList
		semester={semester}
		entries={entries}
		allSemesters={allSemesters}
	/>
</BaseLayout>
