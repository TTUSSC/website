---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DifficultyStars from '../../../components/lectures/DifficultyStars.astro';
import { getLang } from '../../../i18n/ui';

function semesterLabel(semester: string): string {
	const [year, term] = semester.split('-');
	return `${year} ${term === '1' ? '上' : '下'}學期`;
}

export async function getStaticPaths() {
	const lectures = await getCollection('lectures');
	const bySemester = new Map<string, typeof lectures>();
	for (const entry of lectures) {
		const [semester] = entry.id.split('/');
		if (!bySemester.has(semester)) bySemester.set(semester, []);
		bySemester.get(semester)!.push(entry);
	}
	const allSemesters = [...bySemester.keys()].sort().reverse();

	return allSemesters.map((semester) => ({
		params: { semester },
		props: {
			entries: bySemester
				.get(semester)!
				.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
			allSemesters,
		},
	}));
}

interface Props {
	entries: Awaited<ReturnType<typeof getCollection<'lectures'>>>;
	allSemesters: string[];
}

const { semester } = Astro.params as { semester: string };
const { entries, allSemesters } = Astro.props as Props;
const lang = getLang(Astro.currentLocale);

const content = {
	'zh-tw': {
		eyebrow: 'Lectures',
		heading: '社課',
		intro:
			'學長姐手把手教學，搭配業界前輩實戰分享。在這裡，你可以學程式、做專案，也能輕鬆交友。無論你的目標是什麼，這裡都有適合你的位置，帶你踏入開源世界的無限可能！',
		difficultyLabel: '了解課程難度分級',
		difficultyIntro:
			'為了方便大家選擇感興趣的活動，我們的課程難度一共分為六個等級：',
		difficultyLevels: [
			{ d: 0, label: '一般性質活動，任何人都可以一同參與。' },
			{ d: 1, label: '非常簡單，適合完全新手，無需任何背景知識。' },
			{ d: 2, label: '簡單，需具備基本概念或基礎能力。' },
			{ d: 3, label: '中等，內容稍具挑戰性，適合已有相關經驗的人。' },
			{ d: 4, label: '困難，需要較多背景知識或具備一定專業技能。' },
			{ d: 5, label: '非常困難，適合高水準的學習者或專業人士。' },
		],
		filters: { all: '全部', main: '主線', side: '支線' },
		empty: '這學期目前還沒有社課資料。',
	},
} as const;
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
---

<BaseLayout
	title={`${t.heading}｜${semesterLabel(semester)}`}
	description={t.intro}
>
	<div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
		<span
			class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-moss"
			>{t.eyebrow}</span
		>
		<h1 class="font-display text-3xl md:text-4xl font-bold text-ink mt-2 mb-3">
			{t.heading}
		</h1>
		<p class="text-base md:text-lg text-clay leading-relaxed max-w-3xl mb-4">
			{t.intro}
		</p>

		<div class="relative group inline-block z-20 mb-6">
			<div
				class="flex items-center gap-1.5 text-clay cursor-help hover:text-ink transition-colors"
			>
				<svg
					class="w-4 h-4 text-moss"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"
					></path>
				</svg>
				<span class="text-sm border-b border-dashed border-clay/50"
					>{t.difficultyLabel}</span
				>
			</div>
			<div
				class="absolute left-0 top-full mt-2 w-[320px] sm:w-[500px] p-5 bg-paper backdrop-blur-xl border border-chalk/80 shadow-xl rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0 origin-top-left pointer-events-none group-hover:pointer-events-auto"
			>
				<p class="text-[13px] text-ink/90 leading-relaxed mb-4">
					{t.difficultyIntro}
				</p>
				<ul class="space-y-2.5 text-[13px] text-ink/80 font-medium">
					{
						t.difficultyLevels.map((level) => (
							<li class="flex items-center gap-3">
								<DifficultyStars
									difficulty={level.d}
									idPrefix={`legend-${level.d}`}
								/>
								<span>：{level.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="flex flex-wrap gap-2 mb-6">
			{
				allSemesters.map((s) => (
					<a
						href={getRelativeLocaleUrl(lang, `lecture/${s}`)}
						class:list={[
							'px-3 py-1.5 text-xs font-display font-medium rounded-md transition-all duration-200',
							s === semester
								? 'bg-ink text-paper'
								: 'text-clay border border-chalk hover:border-ink hover:text-ink',
						]}
					>
						{semesterLabel(s)}
					</a>
				))
			}
		</div>

		<div class="flex gap-2 mb-8">
			<button
				type="button"
				data-filter="全部"
				class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-rust text-paper"
			>
				{t.filters.all}
			</button>
			<button
				type="button"
				data-filter="主線"
				class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-fog text-clay hover:text-ink"
			>
				{t.filters.main}
			</button>
			<button
				type="button"
				data-filter="支線"
				class="lecture-filter-btn px-3 py-1 text-xs font-display font-medium rounded-sm transition-all bg-fog text-clay hover:text-ink"
			>
				{t.filters.side}
			</button>
		</div>

		<div class="space-y-2">
			{
				entries.map((entry) => (
					<a
						href={getRelativeLocaleUrl(
							lang,
							`lecture/${semester}/${entry.data.slug}`,
						)}
						class="lecture-card flex items-center gap-4 bg-paper-warm rounded-2xl border border-chalk/60 px-6 py-5 transition-all duration-300 hover:border-rust/30 hover:shadow-md"
						data-type={entry.data.type}
					>
						<div class="shrink-0 w-14 text-center">
							<span class="text-xs font-mono text-sand">
								{entry.data.date.toLocaleDateString('zh-TW', {
									month: 'numeric',
									day: 'numeric',
								})}
							</span>
						</div>
						<div class="flex-1 min-w-0">
							<h3 class="font-display font-semibold text-ink text-base leading-snug">
								{entry.data.name}
							</h3>
							<div class="flex items-center gap-2 mt-1 flex-wrap">
								<DifficultyStars
									difficulty={entry.data.difficulty}
									idPrefix={`card-${entry.data.slug}`}
								/>
								<span class="text-xs text-sand">{entry.data.lecturer}</span>
								<span
									class:list={[
										'px-2 py-0.5 text-xs rounded-sm',
										entry.data.type === '主線'
											? 'bg-moss/10 text-moss'
											: 'bg-rust/10 text-rust',
									]}
								>
									{entry.data.type}
								</span>
							</div>
						</div>
					</a>
				))
			}
		</div>

		<p class="text-center text-clay py-12 text-sm hidden" id="lecture-empty">
			{t.empty}
		</p>
	</div>
</BaseLayout>

<script>
	const filterButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('.lecture-filter-btn'),
	);
	const cards = Array.from(
		document.querySelectorAll<HTMLAnchorElement>('.lecture-card'),
	);
	const emptyMessage = document.getElementById('lecture-empty')!;

	const applyFilter = (filter: string) => {
		let visibleCount = 0;
		cards.forEach((card) => {
			const matches = filter === '全部' || card.dataset.type === filter;
			card.classList.toggle('hidden', !matches);
			if (matches) visibleCount++;
		});
		emptyMessage.classList.toggle('hidden', visibleCount > 0);
	};

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			filterButtons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('bg-rust', active);
				b.classList.toggle('text-paper', active);
				b.classList.toggle('bg-fog', !active);
				b.classList.toggle('text-clay', !active);
			});
			applyFilter(button.dataset.filter!);
		});
	});
</script>
