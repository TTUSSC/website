---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang } from '../i18n/ui';

const content = {
	'zh-tw': {
		title: '關於｜科學開源服務社',
		description:
			'科學開源服務社是以學生角度出發的社群，致力於推廣開源文化與資訊透明。',
		eyebrow: 'About',
		heading: '開源，開啟協作與分享的新篇章',
		intro: [
			'在資訊爆炸與技術革新的時代，人們越來越重視智慧財產的保護，期望透過規範帶來便利與創新。然而，隨之而來的專利戰與過度保護，往往阻礙了知識的流通與技術的進步。面對這樣的現實，我們相信事情可以有另一種選擇。',
			'「開源」的本質是分享與協作。從分享智慧到推動文化進步，開源精神讓程式碼在陽光下接受檢視，讓所有人都能參與修正與改良。這種開放的模式不僅防範了隱私侵害與惡意程式，還促成了技術的共同進步，開啟了透明與信任的未來。',
		],
		sections: [
			{
				title: '我們是誰？',
				bar: 'bg-rust',
				text: '科學開源服務社是以學生角度出發的社群，致力於推廣開源文化與資訊透明。我們以行動實踐開源理念，探索開源如何改善生活，改變未來。',
			},
			{
				title: '我們在做什麼？',
				bar: 'bg-moss',
				items: [
					{
						label: '課程',
						text: '舉辦社課、講座與工作坊，帶領社員學習 HackMD、Linux、Git 等技術，培養實力並融入開源社群。',
					},
					{
						label: '社群',
						text: '認識志同道合的朋友，隨時揪團探討技術或參與社群活動，感受協作的魅力。',
					},
					{
						label: '服務',
						text: '寒暑假舉辦資訊相關營隊，將所學回饋社群，實現服務與學習的結合。',
					},
				],
			},
			{
				title: '加入我們',
				bar: 'bg-clay',
				text: '社課的時間和資訊會在每學期公告於網站上，每個禮拜 IG 上也會貼文公告。歡迎一同加入科學開源服務社，探索開源的世界，讓分享與協作成為你的日常！',
			},
		],
	},
	en: {
		title: 'About | TTUSSC',
		description:
			'TTUSSC is a student-run community dedicated to promoting open-source culture and information transparency.',
		eyebrow: 'About',
		heading: 'Open Source: A New Chapter of Collaboration and Sharing',
		intro: [
			'In an age of information explosion and rapid technological change, people increasingly value the protection of intellectual property, hoping regulation brings convenience and innovation. Yet the patent wars and over-protection that follow often hinder the flow of knowledge and the progress of technology. Facing this reality, we believe there is another way.',
			'The essence of "open source" is sharing and collaboration. From sharing knowledge to advancing culture, the open-source spirit puts code out in the open for everyone to review, letting anyone take part in fixing and improving it. This open model not only guards against privacy breaches and malicious software, but also drives technology forward together, opening the way to a future built on transparency and trust.',
		],
		sections: [
			{
				title: 'Who We Are',
				bar: 'bg-rust',
				text: 'TTUSSC is a student-run community dedicated to promoting open-source culture and information transparency. We put open-source ideals into practice, exploring how open source can improve daily life and shape the future.',
			},
			{
				title: 'What We Do',
				bar: 'bg-moss',
				items: [
					{
						label: 'Courses',
						text: 'We hold lectures, talks, and workshops teaching members tools like HackMD, Linux, and Git, building real skills and connecting them with the open-source community.',
					},
					{
						label: 'Community',
						text: 'Meet like-minded friends, gather anytime to discuss tech or join community events, and feel the appeal of working together.',
					},
					{
						label: 'Service',
						text: "We run tech-focused volunteer camps every winter and summer break, giving back to the community by putting what we've learned into practice.",
					},
				],
			},
			{
				title: 'Join Us',
				bar: 'bg-clay',
				text: 'Lecture schedules and details are posted on our website each semester, with weekly updates on our Instagram too. Come join TTUSSC, explore the world of open source, and make sharing and collaboration part of your everyday life!',
			},
		],
	},
} as const;

const lang = getLang(Astro.currentLocale);
const t = content[lang as keyof typeof content] ?? content['zh-tw'];
---

<BaseLayout title={t.title} description={t.description}>
	<div class="max-w-5xl mx-auto px-6 py-20 md:py-24">
		<span
			class="text-[11px] font-display font-semibold uppercase tracking-[0.2em] text-moss reveal"
		>
			{t.eyebrow}
		</span>
		<h1
			class="reveal reveal-d1 font-display text-3xl md:text-4xl font-bold text-ink mt-2 mb-10"
		>
			{t.heading}
		</h1>

		<div
			class="reveal reveal-d2 space-y-5 text-clay leading-[1.85] text-[15px] max-w-2xl"
		>
			{t.intro.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<div class="mt-14 space-y-10 reveal reveal-d3 max-w-2xl">
			{
				t.sections.map((section) => (
					<div>
						<h3 class="font-display text-lg font-semibold text-ink mb-3 flex items-center gap-3">
							<span class:list={['w-6 h-0.5 rounded-full', section.bar]} />
							{section.title}
						</h3>
						{'items' in section ? (
							<ul class="space-y-3 ml-9">
								{section.items.map((item) => (
									<li class="text-[15px] text-clay leading-relaxed">
										<strong class="text-ink">{item.label}</strong>：{item.text}
									</li>
								))}
							</ul>
						) : (
							<p class="text-[15px] text-clay leading-relaxed ml-9">
								{section.text}
							</p>
						)}
					</div>
				))
			}
		</div>
	</div>
</BaseLayout>
